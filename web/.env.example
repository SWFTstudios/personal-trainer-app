# Public URL of this site (used for Stripe and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Built By Me EZ

# Supabase (same project as the iOS app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for public pages, booking creation and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (platform account)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices for the trainer subscription
STRIPE_PRICE_STARTER=   # $29/mo
STRIPE_PRICE_PRO=       # $49/mo
# Optional platform cut of each client payment, in basis points (100 = 1%)
PLATFORM_FEE_BPS=0
