# Local development only (`next dev`). In production these are Worker vars/secrets
# (see wrangler.jsonc). Copy to .dev.vars for `wrangler dev`, or .env.local for `next dev`.
SITE_URL=http://localhost:3000
PRODUCT_NAME=Built By Me EZ

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
PLATFORM_FEE_BPS=0

# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Web push (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: full YouTube / Vimeo channel imports
YOUTUBE_API_KEY=
VIMEO_ACCESS_TOKEN=
